rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function adminRole() {
      return isAdmin() ? adminData().role : null;
    }

    function adminUniversityId() {
      return isAdmin() ? adminData().universityId : null;
    }

    function isSuperAdmin() {
      return adminRole() == "superadmin";
    }

    function isUniversityAdmin() {
      return adminRole() == "university_admin";
    }

    function canWriteUniversity(universityId) {
      return isSuperAdmin() || (isUniversityAdmin() && adminUniversityId() == universityId);
    }

    // ---------- MODULES ----------
    match /modules/{moduleId} {
      allow read: if isSignedIn();     // students + admins
      allow create: if isAdmin() && canWriteUniversity(request.resource.data.universityId);
      allow update: if isAdmin()
        && request.resource.data.universityId == resource.data.universityId
        && canWriteUniversity(resource.data.universityId);
      allow delete: if isAdmin() && canWriteUniversity(resource.data.universityId);
    }

    // ---------- UNIVERSITIES ----------
    match /universities/{universityId} {
      allow read: if true;             // public list is fine
      allow create, update, delete: if isSuperAdmin();
    }

    // ---------- ANNOUNCEMENTS ----------
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && (isSuperAdmin() || request.resource.data.universityId == adminUniversityId());
      allow update: if isAdmin()
        && (isSuperAdmin() || resource.data.universityId == adminUniversityId())
        && request.resource.data.universityId == resource.data.universityId;
      allow delete: if isAdmin() && (isSuperAdmin() || resource.data.universityId == adminUniversityId());
    }

    // ---------- ASSESSMENTS ----------
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && canWriteUniversity(request.resource.data.universityId);
      allow update: if isAdmin()
        && request.resource.data.universityId == resource.data.universityId
        && canWriteUniversity(resource.data.universityId);
      allow delete: if isAdmin() && canWriteUniversity(resource.data.universityId);

      // Subcollection: questions under an assessment
      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // ---------- USERS ----------
    match /users/{userId} {
      // Read own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Registration: user creates ONLY their own doc (docId must equal auth.uid)
      allow create: if isOwner(userId);

      // User can update ONLY safe fields on their own profile
      // (Prevents users from giving themselves points/subscription/admin stuff)
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "name",
            "universityId",
            "updatedAt"
          ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "name",
            "points",
            "subscriptionActive",
            "subscriptionExpiry",
            "banned",
            "updatedAt"
          ]);

      // Only admins can delete user docs (optional)
      allow delete: if isAdmin();

      // Subcollection: user's module list
      match /modules/{docId} {
        // user can manage their own added modules
        allow read, create, update, delete: if isOwner(userId);
      }
    }
// ---------- UPLOADS ----------
match /uploads/{uploadId} {
  // user can create their own upload record
  allow create: if isSignedIn();

  // user can read their own uploads; admins can read all
  allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);

  // only admins can update status/metadata
  allow update, delete: if isAdmin();
}
match /user_uploads/{docId} {
  allow create: if isSignedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == "pending";
  allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
  allow update, delete: if isAdmin();
}

// ---------- REPORTS ----------
match /reports/{reportId} {
  allow create: if isSignedIn();
  allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
  allow update, delete: if isAdmin();
}
    // ---------- ADMINS ----------
    match /admins/{adminId} {
      allow read: if isSuperAdmin() || isOwner(adminId);

      allow create, update, delete: if isSuperAdmin();
    }

    match /system_config/{configId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /admin_upload_batches/{batchId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && (isSuperAdmin() || request.auth.uid == resource.data.createdBy);
      allow delete: if isSuperAdmin();

      match /items/{itemId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
